# Copy to .env and adjust. Restart `npm start` after changing it.

# NVIP backend origin (the frontend calls <origin>/api/v1/...).
REACT_APP_NVIP_API_URL=http://localhost:8000

# true (default): serve built-in demo data, no backend needed.
# false: call the real NVIP backend at REACT_APP_NVIP_API_URL.
REACT_APP_NVIP_USE_MOCKS=true
